# =================================================================
# KOMPRAX LANDING PAGE - VARIÁVEIS DE AMBIENTE
# =================================================================

# =================================================================
# INTEGRAÇÃO N8N
# =================================================================
# URL do webhook N8N para processamento de leads
N8N_WEBHOOK_URL=https://n8nub.mooveinsd.com.br/webhook-test/komprax

# =================================================================
# CONFIGURAÇÕES DA APLICAÇÃO
# =================================================================
# URL base da aplicação (importante para webhooks em produção)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Ambiente de execução (development, production, test)
NODE_ENV=development

# =================================================================
# CONFIGURAÇÕES DE SEGURANÇA
# =================================================================
# Rate limiting - número máximo de requests por minuto por IP
RATE_LIMIT_MAX_REQUESTS=5

# Secret para assinatura de tokens (se necessário no futuro)
# JWT_SECRET=your-secret-key-here

# =================================================================
# ANALYTICS (OPCIONAL)
# =================================================================
# Google Analytics ID (se implementado)
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Facebook Pixel ID (se implementado)
# NEXT_PUBLIC_FB_PIXEL_ID=123456789

# =================================================================
# MONITORAMENTO (OPCIONAL)
# =================================================================
# Sentry DSN para tracking de erros
# SENTRY_DSN=https://your-sentry-dsn

# =================================================================
# NOTAS IMPORTANTES
# =================================================================
# 1. Copie este arquivo para .env.local para desenvolvimento
# 2. Nunca commite arquivos .env* com dados reais
# 3. Em produção, configure essas variáveis no seu provider (Vercel, Netlify, etc.)
# 4. O N8N_WEBHOOK_URL deve ser uma URL pública acessível 